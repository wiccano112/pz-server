# ==============================================================================
# PROJECT ZOMBOID STAGING SERVER CONFIGURATION (42.21 UNSTABLE)
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env

# --- Container & Server Identification ---
CONTAINER_NAME=pz-rpm-server-stg
SERVER_NAME=pz-rpm-server-stg

# --- Game Branch ---
# unstable = Build 42 Unstable (42.21)
SERVER_BRANCH=unstable

ADMIN_PASSWORD=StagingAdminPassword123!
RCON_PASSWORD=StagingAdminPassword123!

# --- Resource Allocation ---
MAX_RAM=6G
MEMORY_XMX_GB=6
MEMORY_XMS_GB=4
MEM_LIMIT=6g
CPUSET=0-3

# --- Permissions ---
PUID=1000
PGID=1000

# --- Networking & Ports (Non-conflicting with PRD 16261/16262/27015) ---
# 17261/UDP: Game physics & main network loop
# 17262/UDP: Direct client connection
# 27025/TCP: Steam Query protocol / RCON
GAME_PORT=17261
DIRECT_PORT=17262
RCON_PORT=27025
DEFAULT_PORT=17261
UDP_PORT=17262

# --- Storage ---
DATA_PATH=./data
