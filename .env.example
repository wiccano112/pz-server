# ==============================================================================
# PROJECT ZOMBOID DEDICATED SERVER CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure all variables:
# cp .env.example .env

# --- Container & Server Identification ---
CONTAINER_NAME=pz-server
SERVER_NAME=pzserver

# --- Security & Administration ---
ADMIN_PASSWORD=your_secure_admin_password_here

# --- Resource Allocation ---
# Suggested values: 4G, 8G, 12G, 16G (Minimum 4G for vanilla, 8G+ for modded)
MAX_RAM=8G

# --- Permissions ---
# UID/GID of the user running Docker on the host
PUID=1000
PGID=1000

# --- Networking & Ports ---
# 16261/UDP: Game physics & main network loop
# 16262/UDP: Direct client connection
# 27015/TCP: Steam Query protocol / RCON
GAME_PORT=16261
DIRECT_PORT=16262
RCON_PORT=27015

# --- Storage ---
DATA_PATH=./data
